# ConsensusKill environment reference. Copy to `.env` for local overrides
# (`.env` is gitignored). Every value below is the built-in default unless
# noted - you only need to set what you change.

# --- backend ---------------------------------------------------------------
# Local dev uses redis-server on 6379; hosted deploys use Upstash (TLS!).
REDIS_URL=redis://localhost:6379/0

# XREADGROUP block time in ms. 0 or negative = read without BLOCK (required
# for Upstash, which forbids blocking reads; the engine waits on the wake
# channel instead and polls every ENGINE_EMPTY_POLL_DELAY seconds).
ENGINE_BLOCK_MS=1000
ENGINE_BATCH=20
ENGINE_EMPTY_POLL_DELAY=0.05

# Deadline-cached timer loop (cost controls for hosted Redis).
ENGINE_TICK_SECONDS=0.2 # due-check sleep / BUSY retry
ENGINE_RESCAN_SECONDS=30 # reconcile deadline cache with Redis
ENGINE_IDLE_TICK_SECONDS=60 # rescan cadence while no rooms exist
ENGINE_SWEEP_SECONDS=300 # empty-room sweeper
ENGINE_BUSY_RETRY_SECONDS=0.5

# Gateway
ALLOWED_ORIGINS=*
ADMIN_TOKEN= # protects POST /admin/kill when set
# Run gateway + engine in one process (Render free tier / local single proc):
EMBEDDED_ENGINE=

# --- optional Supabase question bank (shared/questions.py) -----------------
# When both are set the engine prefers Supabase and falls back to
# data/questions.json on any failure.
SUPABASE_URL=
SUPABASE_KEY=

# --- scripts ---------------------------------------------------------------
# scripts/seed_supabase.py (needs the table from supabase/questions.sql):
SUPABASE_SERVICE_KEY=

# --- frontend build-time (Vercel project settings / npm run build) ---------
# VITE_WS_URL: full WebSocket URL when it is NOT same-origin
# (the Vercel deployment has no WS proxy, so set this to wss://<render>/ws).
VITE_WS_URL=
# VITE_GATEWAY_URL: HTTP gateway base URL for the dev/preview /ws + /health
# proxy (vite.config.ts). Production same-origin deployments need neither.
VITE_GATEWAY_URL=http://127.0.0.1:8000
